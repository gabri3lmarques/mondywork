RewriteEngine On

# Pagina individual de vaga
RewriteRule ^vaga/(.+)$ vaga.php?id=$1 [L,QSA]

# Sitemap dinamico
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Redirecionar api.php sem precisar da extensao
RewriteRule ^api$ api.php [L,QSA]

# Cache de imagens e fontes (sem CSS/JS para evitar cache agressivo)
<FilesMatch "\.(jpe?g|png|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800, immutable"
</FilesMatch>

# Seguranca basica
<FilesMatch "^\.|config\.php$">
    Deny from all
</FilesMatch>

DirectoryIndex index.php index.html
